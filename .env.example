# NanoClaw Environment Configuration
# Copy this to .env and fill in your values

# --- Telegram (multi-bot) ---
# JSON array of bot configs. Each bot gets its own Telegram identity.
# Create bots via @BotFather on Telegram.
TELEGRAM_BOTS='[{"name":"personal","token":"YOUR_PERSONAL_BOT_TOKEN"},{"name":"org","token":"YOUR_ORG_BOT_TOKEN"},{"name":"tt","token":"YOUR_TT_BOT_TOKEN"}]'

# --- Telegram (single bot, backward compatible) ---
# Use this instead of TELEGRAM_BOTS if you only need one bot.
# TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Agentmail ---
# API key from https://console.agentmail.to
AGENTMAIL_API_KEY=your_agentmail_api_key

# Webhook server port (cloudflared tunnels external traffic here)
AGENTMAIL_WEBHOOK_PORT=8800

# Webhook signing secret (returned when creating webhook via Agentmail API)
AGENTMAIL_WEBHOOK_SECRET=whsec_your_webhook_secret

# Maps Agentmail inbox IDs to NanoClaw group JIDs.
# Format: {"inbox_id": "tg:botname:chat_id", ...}
# Chat IDs are discovered by sending /chatid to each Telegram bot.
AGENTMAIL_INBOX_MAP='{"YOUR_PERSONAL_INBOX_ID":"tg:personal:CHAT_ID","YOUR_ORG_INBOX_ID":"tg:org:CHAT_ID","YOUR_TT_INBOX_ID":"tg:tt:CHAT_ID"}'

# --- Assistant ---
# ASSISTANT_NAME=Andy
# TIMEZONE=America/New_York
